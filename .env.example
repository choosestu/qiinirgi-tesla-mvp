TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://qiinirgi.com/auth/tesla/callback
TESLA_AUTH_BASE=https://auth.tesla.com
PORT=3000

# Required by Tesla's current Fleet API docs:
# Token exchange must use the fleet-auth domain, and the token `audience`
# must be your region's Fleet API base URL.
TESLA_TOKEN_BASE=https://fleet-auth.prd.vn.cloud.tesla.com
TESLA_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com

# Vehicle commands: modern (2021+) vehicles reject unsigned REST commands.
# Run Tesla's Vehicle Command Proxy (github.com/teslamotors/vehicle-command)
# with your virtual key and point this at it. Defaults to TESLA_API_BASE.
TESLA_COMMAND_BASE=


# Solar-aware EV charging (see src/solar.ts). Leave unset to disable.
BATTERY_RESERVE_SOC_PERCENT=90
ASSUMED_VOLTAGE_V=240
SURPLUS_BUFFER_W=200

# Legacy local-bridge posting path (POST /solar/reading). Not needed now
# that the server polls iSolarCloud directly -- kept for manual testing.
LOCAL_BRIDGE_API_KEY=

# Sungrow iSolarCloud OpenAPI (see src/sungrowAuth.ts, src/sungrow.ts).
# Create an app at developer-api.isolarcloud.com, have the plant owner
# share their plant with it, then fill these in -- the server polls
# automatically every SUNGROW_POLL_INTERVAL_MS once they're set.
SUNGROW_APP_KEY=
SUNGROW_APP_SECRET=
SUNGROW_APP_ID=
# One of: China, International, Europe, Australia, India
SUNGROW_REGION=Australia
SUNGROW_REDIRECT_URI=https://qiinirgi.com/sungrow/callback
# Optional: override which plant to poll. Leave unset to use the account's
# first (only) plant.
SUNGROW_PLANT_ID=
SUNGROW_POLL_INTERVAL_MS=300000
